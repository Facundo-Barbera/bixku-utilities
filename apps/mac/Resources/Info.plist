<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>online.bixku.utilities</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Bixku Utilities</string>
    <key>CFBundleDisplayName</key>
    <string>Bixku Utilities</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- Menu-bar app: no Dock icon; the main window is opened from the menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!--
      bixku://notify URL scheme: lets scripts and the bixku-notify helper hand notifications
      to the Dock module (see docs/notifications.md). Input is validated and rate limited.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>online.bixku.utilities.url</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>bixku</string>
            </array>
        </dict>
    </array>
    <key>NSFocusStatusUsageDescription</key>
    <string>Bixku Utilities can check whether a Focus is on, so the Dock module can respect it when it holds back notifications.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Facundo Barbera. MIT License.</string>
    <!--
      Sparkle auto-updates. Filled in by apps/mac/release/render-plist.py at packaging time
      (UPDATES_BASE_URL and SPARKLE_ED_PUBLIC_KEY come from GitHub variables). When either is
      missing (local builds) every SU* key is removed and the updater stays disabled.
      SUScheduledCheckInterval and SUAutomaticallyUpdate are converted to integer/bool.
    -->
    <key>SUFeedURL</key>
    <string>$(UPDATES_BASE_URL)/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>$(SPARKLE_ED_PUBLIC_KEY)</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <string>$(SPARKLE_CHECK_INTERVAL)</string>
    <key>SUAutomaticallyUpdate</key>
    <string>$(SPARKLE_AUTO_UPDATE)</string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
